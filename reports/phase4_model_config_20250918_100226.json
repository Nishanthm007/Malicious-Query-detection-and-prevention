{
  "architecture_type": "Multi-input 1D CNN",
  "branches": {
    "word_branch": {
      "input_shape": "(75,)",
      "embedding_dim": 300,
      "vocab_size": 20000,
      "conv_filters": [
        3,
        4,
        5
      ],
      "num_filters": 128
    },
    "char_branch": {
      "input_shape": "(300,)",
      "embedding_dim": 50,
      "vocab_size": 72,
      "conv_filters": [
        3,
        4,
        5
      ],
      "num_filters": 128
    },
    "structural_branch": {
      "input_shape": "(135,)",
      "dense_layers": [
        256,
        128
      ],
      "dropout_rate": 0.5
    }
  },
  "fusion_layers": {
    "concatenate_dim": 896,
    "batch_normalization": true,
    "dropout_rate": 0.5,
    "dense_layers": [
      256,
      64
    ],
    "output_activation": "sigmoid"
  }
}